---
# This file is a Liquid template. Jekyll processes it at build time and outputs
# a static graph.json describing the post-network (nodes + links).
#   - Each post becomes a node (id = post URL, so click navigation uses node.id).
#   - Two posts are linked when they share at least one tag.
layout: null
sitemap: false
---
{% comment %}
  Build the links first into a capture buffer.
  For every unordered pair of posts (j > i) we emit a link when they share a tag.
  Each entry is prefixed with a comma; the leading comma is stripped on output,
  which keeps the resulting JSON valid without trailing commas.
{% endcomment %}
{%- capture links_json -%}
{%- for post in site.posts -%}
  {%- assign i = forloop.index0 -%}
  {%- for other in site.posts -%}
    {%- assign j = forloop.index0 -%}
    {%- if j > i -%}
      {%- assign shared = false -%}
      {%- for tag in post.tags -%}
        {%- if other.tags contains tag -%}
          {%- assign shared = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if shared -%}
        ,{"source":{{ post.url | relative_url | jsonify }},"target":{{ other.url | relative_url | jsonify }}}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- endcapture -%}
{
  "nodes": [
    {%- for post in site.posts -%}
    {
      "id": {{ post.url | relative_url | jsonify }},
      "name": {{ post.title | jsonify }},
      "group": {{ post.categories[0] | default: "Uncategorized" | jsonify }},
      "tags": {{ post.tags | jsonify }},
      "val": {{ post.tags | size | plus: 1 }}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "links": [
    {{ links_json | remove_first: "," }}
  ]
}
